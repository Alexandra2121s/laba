#include <stdio.h>

int main() {
    double A, B;
    
    // Ввод двух вещественных чисел
    printf("Введите два вещественных числа A и B: ");
    scanf("%lf %lf", &A, &B);
    
    // Вывод исходных значений
    printf("Исходные значения: A = %.2lf, B = %.2lf\n", A, B);
    
    // Если A больше B, меняем их местами
    if (A > B) {
        double temp = A;  // Временная переменная для обмена
        A = B;
        B = temp;
    }
    
    // Вывод новых значений
    printf("Новые значения:    A = %.2lf, B = %.2lf\n", A, B);
    
    return 0;
}