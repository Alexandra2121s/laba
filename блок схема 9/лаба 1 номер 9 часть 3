#include <stdio.h>

// Процедура для добавления цифры D слева к числу K
void AddLeftDigit(int D, int *K) {
    // Находим количество цифр в текущем числе K
    int temp = *K;
    int multiplier = 1;
    
    // Определяем множитель (10 в степени количества цифр в K)
    // Если K = 0, то multiplier должен быть равен 10
    if (temp == 0) {
        multiplier = 10;
    } else {
        while (temp > 0) {
            multiplier *= 10;
            temp /= 10;
        }
    }
    
    // Добавляем цифру D слева: D * multiplier + K
    *K = D * multiplier + *K;
}

int main() {
    int K;
    int D1, D2;
    
    // Ввод исходного числа K
    printf("Введите целое положительное число K: ");
    scanf("%d", &K);
    
    if (K <= 0) {
        printf("Ошибка: K должно быть положительным числом!\n");
        return 1;
    }
    
    // Ввод первой цифры D1
    printf("Введите первую цифру D1 (1-9): ");
    scanf("%d", &D1);
    
    if (D1 < 1 || D1 > 9) {
        printf("Ошибка: D1 должно быть цифрой от 1 до 9!\n");
        return 1;
    }
    
    // Ввод второй цифры D2
    printf("Введите вторую цифру D2 (1-9): ");
    scanf("%d", &D2);
    
    if (D2 < 1 || D2 > 9) {
        printf("Ошибка: D2 должно быть цифрой от 1 до 9!\n");
        return 1;
    }
    
    // Вывод исходного числа
    printf("\nИсходное число K: %d\n", K);
    
    // Добавление первой цифры D1
    AddLeftDigit(D1, &K);
    printf("После добавления цифры %d слева: K = %d\n", D1, K);
    
    // Добавление второй цифры D2
    AddLeftDigit(D2, &K);
    printf("После добавления цифры %d слева: K = %d\n", D2, K);
    
    return 0;
}