#include <stdio.h>
#include <stdlib.h>

int main() {
    int N;
    char C1, C2;
    
    // Ввод данных
    printf("Введите четное число N (>0): ");
    scanf("%d", &N);
    
    // Проверка, что N четное и положительное
    if (N <= 0) {
        printf("Ошибка: N должно быть больше 0!\n");
        return 1;
    }
    
    if (N % 2 != 0) {
        printf("Ошибка: N должно быть четным числом!\n");
        return 1;
    }
    
    // Ввод символов
    printf("Введите первый символ C1: ");
    scanf(" %c", &C1);  // Пробел перед %c игнорирует пробельные символы
    
    printf("Введите второй символ C2: ");
    scanf(" %c", &C2);
    
    // Создание строки
    char *result = (char *)malloc((N + 1) * sizeof(char));
    if (result == NULL) {
        printf("Ошибка выделения памяти!\n");
        return 1;
    }
    
    // Заполнение строки чередующимися символами
    for (int i = 0; i < N; i++) {
        if (i % 2 == 0) {
            result[i] = C1;  // Четные позиции (начиная с 0) - C1
        } else {
            result[i] = C2;  // Нечетные позиции - C2
        }
    }
    
    result[N] = '\0';  // Завершающий нулевой символ
    
    // Вывод результата
    printf("Результат: %s\n", result);
    
    // Вывод в виде последовательности символов
    printf("Символы по порядку: ");
    for (int i = 0; i < N; i++) {
        printf("%c", result[i]);
        if (i < N - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    // Освобождение памяти
    free(result);
    
    return 0;
}