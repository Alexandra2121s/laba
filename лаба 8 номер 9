#include <stdio.h>
#include <math.h>

int main() {
    int N;
    
    // Ввод размера массива
    printf("Введите размер массива N: ");
    scanf("%d", &N);
    
    // Проверка корректности размера
    if (N <= 0) {
        printf("Ошибка: размер массива должен быть положительным!\n");
        return 1;
    }
    
    // Выделение памяти под массив
    int arr[N];
    
    // Ввод элементов массива
    printf("Введите %d ненулевых целых чисел:\n", N);
    for (int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] == 0) {
            printf("Ошибка: все числа должны быть ненулевыми!\n");
            return 1;
        }
    }
    
    // Если в массиве всего 1 или 2 элемента
    if (N == 1) {
        printf("В массиве всего 1 элемент. Выводим 0\n");
        printf("0\n");
        return 0;
    }
    else if (N == 2) {
        // Любые два ненулевых числа образуют геометрическую прогрессию
        double q = (double)arr[1] / arr[0];
        printf("Знаменатель прогрессии: %.6lf\n", q);
        return 0;
    }
    
    // Вычисляем знаменатель прогрессии (отношение второго элемента к первому)
    double q = (double)arr[1] / arr[0];
    
    // Проверяем, соблюдается ли это отношение для всех последующих пар
    for (int i = 2; i < N; i++) {
        double current_ratio = (double)arr[i] / arr[i-1];
        
        // Сравниваем с заданной точностью (из-за возможных ошибок округления)
        if (fabs(current_ratio - q) > 1e-9) {
            printf("Элементы не образуют геометрическую прогрессию\n");
            printf("0\n");
            return 0;
        }
    }
    
    // Если прошли все проверки
    printf("Элементы образуют геометрическую прогрессию\n");
    printf("Знаменатель прогрессии: %.6lf\n", q);
    
    return 0;
}