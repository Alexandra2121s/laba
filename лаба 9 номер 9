#include <stdio.h>

int main() {
    int M, N;
    
    // Ввод размеров матрицы
    printf("Введите количество строк M и столбцов N: ");
    scanf("%d %d", &M, &N);
    
    if (M <= 0 || N <= 0) {
        printf("Ошибка: размеры матрицы должны быть положительными!\n");
        return 1;
    }
    
    // Создание матрицы
    int matrix[M][N];
    
    // Ввод элементов матрицы
    printf("Введите элементы матрицы %dx%d:\n", M, N);
    for (int i = 0; i < M; i++) {
        printf("Строка %d: ", i + 1);
        for (int j = 0; j < N; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }
    
    printf("\nРезультаты:\n");
    
    // Обработка каждой строки
    for (int i = 0; i < M; i++) {
        // Вычисление суммы элементов строки
        int sum = 0;
        for (int j = 0; j < N; j++) {
            sum += matrix[i][j];
        }
        
        // Вычисление среднего арифметического
        double average = (double)sum / N;
        
        // Подсчет элементов, меньших среднего
        int count = 0;
        for (int j = 0; j < N; j++) {
            if (matrix[i][j] < average) {
                count++;
            }
        }
        
        // Вывод результата для текущей строки
        printf("Строка %d: среднее = %.2f, элементов меньше среднего = %d\n", 
               i + 1, average, count);
    }
    
    return 0;
}