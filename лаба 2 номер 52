#include <stdio.h>

int main() {
    int number, original;
    
    // Ввод трехзначного числа
    printf("Введите трехзначное число: ");
    scanf("%d", &number);
    
    // Сохраняем исходное число для вывода
    original = number;
    
    // Проверка, что число действительно трехзначное (от 100 до 999 или от -999 до -100)
    if ((number < 100 && number > -100) || number > 999 || number < -999) {
        printf("Ошибка: число должно быть трехзначным!\n");
        return 1;
    }
    
    // Для отрицательных чисел работаем с модулем
    int is_negative = 0;
    if (number < 0) {
        is_negative = 1;
        number = -number;  // Работаем с положительным числом
    }
    
    // Получаем отдельные цифры числа
    int hundreds = number / 100;        // сотни
    int tens = (number / 10) % 10;      // десятки
    int units = number % 10;            // единицы
    
    // Формируем новое число: зачеркиваем первую справа цифру (единицы) 
    // и приписываем ее слева
    int new_number = units * 100 + hundreds * 10 + tens;
    
    // Если исходное число было отрицательным, восстанавливаем знак
    if (is_negative) {
        new_number = -new_number;
    }
    
    // Вывод результата
    printf("Исходное число: %d\n", original);
    printf("Преобразованное число: %d\n", new_number);
    
    return 0;
}