int main() {
    int number, hundreds;
    
    // Ввод трехзначного числа
    printf("Введите трехзначное число: ");
    scanf("%d", &number);
    
    // Получение первой цифры (сотен) с помощью деления нацело
    hundreds = number / 100;
    
    // Вывод результата
    printf("Первая цифра (сотни): %d\n", hundreds);
    
    return 0;
}

