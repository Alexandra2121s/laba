#include <stdio.h>

int main() {
    double a, b, c, V, S;
    
    // Ввод длин ребер
    printf("Введите a, b, c: ");
    scanf("%lf %lf %lf", &a, &b, &c);
    
    // Вычисление объема и площади поверхности
    V = a * b * c;
    S = 2 * (a * b + b * c + a * c);
    
    // Вывод результатов
    printf("Объем: V = %.2lf\n", V);
    printf("Площадь поверхности: S = %.2lf\n", S);
    
    return 0;
}

//Для использования программы достаточно ввести три числа через пробел, например:
Ввод: 3.5 2.1 4.0
