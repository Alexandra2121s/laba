#include <stdio.h>

int main() {
    int A, B;
    
    printf("Введите два целых числа A и B: ");
    scanf("%d %d", &A, &B);
    
    // Используем целочисленный тип для результата (0 - ложь, 1 - истина)
    int result = (A % 2 != 0) || (B % 2 != 0);
    
    printf("Утверждение: 'Хотя бы одно из чисел A и B нечетное' - %s\n", 
           result ? "истинно" : "ложно");
    
    return 0;
}