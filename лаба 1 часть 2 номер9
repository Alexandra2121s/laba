#include <stdio.h>

int main() {
    int N;
    double product = 1.0;
    
    // Ввод количества сомножителей
    printf("Введите целое число N (>0): ");
    scanf("%d", &N);
    
    // Проверка корректности ввода
    if (N <= 0) {
        printf("Ошибка: N должно быть больше 0!\n");
        return 1;
    }
    
    // Вычисление произведения
    for (int i = 1; i <= N; i++) {
        double factor = 1.0 + i * 0.1;  // вычисляем i-й сомножитель: 1.1, 1.2, 1.3, ...
        product *= factor;              // умножаем на текущий сомножитель
    }
    
    // Вывод результата
    printf("Произведение %d сомножителей: %.6f\n", N, product);
    
    return 0;
}