#include <stdio.h>

int main() {
    int D, M;  // День и месяц
    
    // Ввод даты
    printf("Введите день D и месяц M: ");
    scanf("%d %d", &D, &M);
    
    // Вывод исходной даты
    printf("Исходная дата: %d.%d\n", D, M);
    
    // Массив с количеством дней в месяцах (невисокосный год)
    int days_in_month[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    
    // Проверка на корректность введенной даты (по условию дата правильная, но для надежности)
    if (M < 1 || M > 12 || D < 1 || D > days_in_month[M-1]) {
        printf("Ошибка: введена некорректная дата!\n");
        return 1;
    }
    
    // Увеличиваем день на 1
    D++;
    
    // Если день превысил количество дней в текущем месяце
    if (D > days_in_month[M-1]) {
        D = 1;  // Переходим на 1-е число
        M++;    // Переходим на следующий месяц
        
        // Если месяц превысил 12 (декабрь)
        if (M > 12) {
            M = 1;  // Переходим на январь
            // Год увеличивается, но по условию задачи год не выводим
        }
    }
    
    // Вывод следующей даты
    printf("Следующая дата: %d.%d\n", D, M);
    
    return 0;
}