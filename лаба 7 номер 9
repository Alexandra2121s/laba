#include <stdio.h>

int main() {
    int N, K = 0;
    long long power = 1;  // Для хранения 3^K (может быстро расти)
    
    // Ввод числа N
    printf("Введите целое число N (>1): ");
    scanf("%d", &N);
    
    // Проверка корректности ввода
    if (N <= 1) {
        printf("Ошибка: N должно быть больше 1!\n");
        return 1;
    }
    
    // Поиск наименьшего K, при котором 3^K > N
    while (power <= N) {
        K++;
        power *= 3;  // Умножаем на 3 для получения следующей степени
    }
    
    // Вывод результата
    printf("Наименьшее целое K, при котором 3^K > %d: K = %d\n", N, K);
    printf("Проверка: 3^%d = %lld > %d\n", K, power, N);
    if (K > 1) {
        printf("3^(%d-1) = %lld <= %d\n", K, power / 3, N);
    }
    
    return 0;
}